{
  "name": "obj-obs",
  "version": "0.1.0",
  "description": "A simple way to observe JS object value changing by adressing by its path.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "repository": "https://github.com/manufitoussi/obj-obs.git",
  "author": "Emmanuel Fitoussi",
  "license": "MIT",
  "scripts": {
    "demo": "vite demo",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p demo",
    "test": "vitest run --typecheck"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.9.0",
    "vite": "^7",
    "vitest": "^3.2.0"
  }
}
